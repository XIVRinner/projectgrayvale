name=GrayVale Dev Server
clientId=grayvale-local-client
clientSecret=replace-me-client-secret
adminPassword=replace-me-admin-password

# Optional overrides if you want them in the file instead of env vars.
# port=3000
# dbFilePath=../data/grayvale.sqlite
# contentRoot=../../game/src/assets/data

# CORS allowlist — comma-separated list of trusted origins.
# Leave unset (or empty) in local development to allow all origins.
# Set to your production domain(s) when deploying:
# allowedOrigins=https://game.example.com,https://www.example.com
# Environment variable override: GRAYVALE_ALLOWED_ORIGINS
